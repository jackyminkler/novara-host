{
  "functions": [
    {
      "source": "functions",
      "codebase": "hosts",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": [
    {
      "target": "novara-host",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/guest/view",
          "function": { "functionId": "hpGuestView", "region": "us-central1" }
        },
        {
          "source": "/api/guest/submit",
          "function": { "functionId": "hpGuestSubmit", "region": "us-central1" }
        },
        { "source": "**", "destination": "/index.html" }
      ]
    }
  ]
}
